<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>vendor.sony.hardware.camera.provider</name>
        <transport>hwbinder</transport>
        <version>2.4</version>
        <interface>
            <name>IMtkCameraProvider</name>
            <instance>external/0</instance>
        </interface>
    </hal>

    <hal format="hidl">
        <name>vendor.sony.hardware.camera</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>ICameraLensShutter</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IAmbientRecognitionCamera</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>
