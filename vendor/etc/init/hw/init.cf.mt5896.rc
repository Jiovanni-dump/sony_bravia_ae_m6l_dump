on init
    setprop ro.sf.lcd_density 640
    setprop ro.vendor.iview.force_non_realtime 0
    setprop vendor.mtk.sf.lcd.density 640
    setprop vendor.mtk.osd_size 2160p
    setprop vendor.display-size 7680x4320
    setprop vendor.video-decoder-capability 7680x4320x60
    # for osd size
    setprop ro.vendor.max_ui_width 3840
    setprop ro.surface_flinger.max_graphics_width 3840
    setprop ro.surface_flinger.max_graphics_height 2160
    #set soc model
    setprop ro.soc.model t50
    # for b2r support color format
    setprop vendor.mtk.mtkphot.render_output_rgb 0
