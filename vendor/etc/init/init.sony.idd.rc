# Copyright 2018,2023 Sony Corporation
#
on early-boot-sony
    # create idd partition
    mkdir /data/vendor/sony/idd 0751 oem_2906 oem_2906
    mkdir /data/vendor/sony/idd/socket 0711 oem_2906 oem_2906
    mkdir /data/vendor/sony/idd/input 0755 oem_2906 oem_2906
    mkdir /data/vendor/sony/idd/output 0755 oem_2906 oem_2906
    mkdir /data/vendor/sony/idd/private 0700 oem_2906 oem_2906
    mkdir /data/vendor/sony/idd/startup-prober 0700 root root
    mkdir /data/vendor/sony/idd/fsck 0770 root oem_2906
    mkdir /data/vendor/sony/idd/rca 0750 oem_2906 oem_2906
    mkdir /data/vendor/sony/idd/rca/plugins 0750 oem_2906 oem_2906

service iddd /vendor/bin/iddd
    class core
    user oem_2906
    group oem_2906 log inet system
    writepid /dev/cpuset/system-background/tasks
    priority 10