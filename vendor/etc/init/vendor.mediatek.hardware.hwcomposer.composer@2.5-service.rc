service vendor.hwcomposer-2-5 /vendor/bin/hw/vendor.mediatek.hardware.hwcomposer.composer@2.5-service
    class hal animation
    user system
    group graphics drmrpc vendor_realtime root system camera media_rw external_storage
    capabilities SYS_NICE SYS_ADMIN
    onrestart restart surfaceflinger
    writepid /dev/cpuset/system-background/tasks
