# Android fstab file.
#<src>                            <mnt_point>             <type>    <mnt_flags>                                           <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

system                            /system                  ext4      ro,barrier=1                                          wait,avb=vbmeta,logical,first_stage_mount,avb_keys=/avb,slotselect
vendor                            /vendor                  ext4      ro,nodev,barrier=1                                    wait,avb,logical,first_stage_mount,slotselect
vendor_dlkm                       /vendor_dlkm             ext4      noatime,ro,nodev,errors=panic                         wait,logical,first_stage_mount,slotselect,avb
product                           /product                 ext4      ro,nodev,barrier=1                                    wait,avb,logical,first_stage_mount,slotselect
system_ext                        /system_ext              ext4      ro,nodev,barrier=1                                    wait,avb,logical,first_stage_mount,slotselect
/dev/block/by-name/userdata       /data                    ext4      noatime,nosuid,nodev                                  wait,quota,latemount,formattable,reservedsize=128M,checkpoint=block,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/metadata       /metadata                ext4      noatime,nosuid,nodev,noexec,discard,sync              wait,check,formattable,first_stage_mount
/dev/block/by-name/cache          /cache                   ext4      noatime,nosuid,nodev,noexec                           wait
/dev/block/by-name/tvconfig       /vendor/tvconfig         ext4      ro,nosuid,nodev,noexec                                wait,avb,first_stage_mount,slotselect
/dev/block/by-name/mboot_a        /mboot_a                 emmc      defaults                                              defaults
/dev/block/by-name/misc           /misc                    emmc      defaults                                              defaults
/dev/block/by-name/vbmeta         /vbmeta                  emmc      defaults                                              defaults,slotselect
/dev/block/by-name/boot           /boot                    emmc      defaults                                              defaults,slotselect
/dev/block/by-name/vendor_boot    /vendor_boot             emmc      defaults                                              defaults,slotselect
/dev/block/by-name/dtbo           /dtbo                    emmc      defaults                                              defaults,slotselect
/dev/block/by-name/optee          /optee                   emmc      defaults                                              defaults
/dev/block/by-name/armfw          /armfw                   emmc      defaults                                              defaults
/devices/platform/*.usb*          auto                     auto      defaults                                              encryptable=true,voldmanaged=usb:auto
# AOW platform
/dev/block/by-name/bootdata       /mnt/vendor/bootdata     ext4      ro,nodev                                              wait,avb,first_stage_mount,slotselect
/dev/block/by-name/config         /mnt/vendor/config       ext4      ro,nosuid,nodev,noexec                                wait,avb,first_stage_mount,slotselect
/dev/block/by-name/persist        /mnt/vendor/persist      ext4      noatime,nosuid,nodev,noexec                           wait
/dev/block/by-name/certificate    /mnt/vendor/certificate  ext4      noatime,nosuid,nodev,noexec                           wait
/dev/block/by-name/sony_config    /mnt/vendor/sony_config  ext4      ro,nosuid,nodev,noexec                                wait
/dev/block/by-name/featuredata    /mnt/vendor/featuredata  ext4      ro,nosuid,nodev,noexec                                wait,avb,first_stage_mount,slotselect
/dev/block/by-name/supplicant     /oem                     ext4      ro,nodev                                              wait,avb,first_stage_mount,slotselect
