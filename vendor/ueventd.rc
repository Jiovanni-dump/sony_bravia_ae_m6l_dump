/dev/cb2                  0666   root       root
/dev/cli                  0660   root       shell
/dev/log2usb              0660   root       root
/dev/feeder               0660   root       root
/dev/mtphoto              0660   system     system
/dev/fbm_vbi              0660   root       root
/dev/fbm_mpeg             0660   media      system
