	fragment@22 {
		target = <0xffffffff>;

		__overlay__ {
			ip-version = [02 00];
			compatible = "mtk,mali-mt5897";
			interrupt-parent = <0xffffffff>;
			interrupts = <0x00 0x1a 0x04 0x00 0x1a 0x04 0x00 0x1a 0x04>;
			interrupt-names = "JOB\0MMU\0GPU";
			reg = <0x00 0x1c5e0000 0x00 0x4000>;
		};
	};

	fragment@23 {
		target = <0xffffffff>;

		__overlay__ {
			vd_init = <0x00>;
			vd_hsen_normal_detect_win_before_lock = <0x08>;
			vd_hsen_noamrl_detect_win_after_lock = <0x08>;
