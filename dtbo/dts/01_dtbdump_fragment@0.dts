	fragment@14 {
		target = <0xffffffff>;

		__overlay__ {
			GOP_TOTAL_GWIN_NUMBER = <0x05>;
			GOP_AFBC_WIDTH_CAPS = <0xf00 0xf00 0x780 0x780 0x00>;
			GOP_INPUT_MAX_WIDTH_CAP = <0xf00 0xf00 0xf00 0xf00 0x100>;
