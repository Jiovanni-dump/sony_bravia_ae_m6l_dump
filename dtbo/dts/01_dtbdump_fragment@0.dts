			bypassmode_support_planetype = <0x10>;
			support_h_scl_down = <0x01>;
			algo_capability = <0x10000 0x02>;
			algo_header_size = <0x40>;
			support_render_scaling = <0x01>;
			video_mute_version = <0x00>;
			disp_win_version = <0x00>;
			VIDEO_MGW_NUM = <0x01>;
			VIDEO_DMA_SCL_NUM = <0x02>;
			VIDEO_WINDOW_NUM = <0x10>;
			ambient_version = <0x01>;
			enable_expect_pqout_size = <0x00>;
			enable_pqu_ds_size_ctl = <0x00>;
			video_irq_affinity = <0x02>;
			video_freeze_version = <0x00>;
			chip_series = <0x01>;
		};
