	fragment@27 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "mediatek,pm";
			reg = <0x00 0x1c020200 0x00 0x200 0x00 0x1c020000 0x00 0x200>;

			wakeup-source {

				usb {
					id = <0x10>;
					enable = <0x00>;
