/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			android {

				vbmeta {
					compatible = "android,vbmeta";
					parts = "vbmeta,boot,system,vendor,bootdata,tvconfig";
					by_name_prefix = "/dev/block/platform/mstar_mci.0/by-name/vbmeta";
				};
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			ini_path = "audio/";
			pre_init_table = "audio_pre_init_mt5897.ini";
			init_table = "audio_init_mt5897.ini";
			depop_table = "depop_mt5897.ini";
			earc_table = "earc_mt5897.ini";
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			rx-desc-num = <0x200>;
			ethpll-ictrl = <0x01>;
			mac-type = <0x00>;
			phy-process = <0x00>;
			threaded-irq = <0x00>;
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			phys = <0xffffffff 0x03 0xffffffff 0x03 0xffffffff 0x03 0xffffffff 0x04>;
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			phys = <0xffffffff 0x03 0xffffffff 0x03 0xffffffff 0x03 0xffffffff 0x04>;
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {
			mediatek,src_hw_capable;

			usb-phy@1C780000 {
				reg = <0x00 0x1c780000 0x00 0x700>;
				#phy-cells = <0x01>;
				status = "okay";
			};

			usb-phy@1C781000 {
				reg = <0x00 0x1c781000 0x00 0x700>;
				#phy-cells = <0x01>;
				status = "okay";
			};

			usb-phy@1C782000 {
				reg = <0x00 0x1c782000 0x00 0x700>;
				#phy-cells = <0x01>;
				status = "okay";
			};

			usb-phy@1C780700 {
				reg = <0x00 0x1c780700 0x00 0x900>;
				#phy-cells = <0x01>;
				degradation-mode = <0x01>;
				status = "okay";
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			phys = <0xffffffff 0x03 0xffffffff 0x04>;
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			mediatek,src_hw_capable;

			usb-phy@1C1A0000 {
				reg = <0x00 0x1c1a0000 0x00 0x700>;
				#phy-cells = <0x01>;
				status = "okay";
			};

			usb-phy@1C1A0700 {
				reg = <0x00 0x1c1a0700 0x00 0x900>;
				#phy-cells = <0x01>;
				degradation-mode = <0x01>;
				status = "okay";
			};
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {
			usb2-lpm-disable;
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {
			usb2-lpm-disable;
		};
	};

	fragment@10 {
		target = <0xffffffff>;

		__overlay__ {
			ip-version = <0x100>;
		};
	};

	fragment@11 {
		target = <0xffffffff>;

		__overlay__ {
			ngpios = <0x8b>;
			base = <0x00>;
			max-ngpios = <0xc8>;
			irq-both-edge = <0x00>;
		};
	};

	fragment@12 {
		target = <0xffffffff>;

		__overlay__ {
			ngpios = <0x64>;
			base = <0xc8>;
			max-ngpios = <0xc8>;
			irq-both-edge = <0x00>;
			status = "okay";
		};
	};

	fragment@13 {
		target = <0xffffffff>;

		__overlay__ {
			ngpios = <0x64>;
			base = <0xc8>;
			max-ngpios = <0xc8>;
			irq-both-edge = <0x00>;
			status = "disabled";
		};
