				emer-gpio {
					id = <0x4c>;
					enable = <0x00>;
				};

				mute-gpio {
					id = <0x5c>;
					enable = <0x01>;
				};

				lan {
					id = <0x0e>;
					enable = <0x00>;
				};

				cast {
					id = <0x0f>;
					enable = <0x00>;
				};

				owl {
					id = <0x2a>;
					enable = <0x00>;
				};

				dp {
					id = <0x20>;
