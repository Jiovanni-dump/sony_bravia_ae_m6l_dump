	fragment@15 {
		target = <0xffffffff>;

		__overlay__ {
			ip-version = <0x101>;
			capability = <0x26aa1f7d>;
			reg = <0x00 0x1d49b200 0x00 0x2e00 0x00 0x1d49a600 0x00 0x600 0x00 0x1d487800 0x00 0x200>;
