	fragment@21 {
		target = <0xffffffff>;

		__overlay__ {
			mediatek,max_cid_group = <0x02>;
			mediatek,cpu_client_cnt = <0x01>;
			mediatek,cpu_client = <0xc0000000 0x00>;
			mediatek,client_cnt = <0x0d>;
			mediatek,client = <0xc0000000 0x00 0xff80c500 0x00 0xe000e000 0x00 0xff80c580 0x00 0xffffcd0d 0x00 0xff80cb00 0x00 0xffc0c740 0x00 0xffffcc00 0x00 0xfff9c809 0x00 0xfff8c800 0x00 0xffe0c780 0x00 0xffc0c640 0x00 0xff80c200 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
