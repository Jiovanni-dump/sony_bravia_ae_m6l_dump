on init
    mkdir /data/property
    # sdcard/usb mount points
    mkdir /mnt
    mkdir /mnt/sdcard
    mkdir /mnt/usb
    mkdir /mnt/usb/sda1
    mkdir /mnt/usb/mmcblka1
    mkdir /storage

on early-fs
    setprop sys.usb.configfs 1
    setprop sys.usb.controller 1c7a3e00.usb
    # insert usb driver and enable device mode
    # Recovery mode got through this
    insmod /lib/modules/phy-mtk-tphy-tv.ko
    insmod /lib/modules/mtu3.ko mtu3_dev_en=1
    insmod /lib/modules/xhci-mtk-hcd-tv.ko
    insmod /lib/modules/mtk_realtime_producer.ko
    insmod /lib/modules/mtk-tvcpuif.ko
    insmod /lib/modules/mtk-tvpqu.ko
    insmod /lib/modules/mediatek-drm-tv.ko

on fs
    # restore security contexts here to label those device nodes created by utopia
    restorecon /dev/gflip
    restorecon /dev/msmailbox
    restorecon /dev/system

# Set watchdog timer to 30 seconds and pet it every 10 seconds to get a 20 second margin
#service watchdogd /sbin/watchdogd 10 20
#    class core
# enable ir input for reboot recovery case
    write /sys/module/mdrv_ir/parameters/input_event_en 1
    write /sys/module/mdrv_ir/parameters/input_dev_event_enable 1
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/rom_emmc_boot_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/rom_emmc_boot_b

on property:ro.debuggable=1
    start console

service console /system/bin/sh
    class core
    console
    disabled
    user root
    group shell log readproc
    seclabel u:r:shell:s0
    setenv HOSTNAME console
