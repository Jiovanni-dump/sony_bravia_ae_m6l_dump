# ueventd can only set permissions on device nodes and their associated
# sysfs attributes, not on arbitrary paths.
#
# format for /dev rules: devname mode uid gid
# format for /sys rules: nodename attr mode uid gid
# shortcut: "mtd@NN" expands to "/dev/mtd/mtdNN"

/dev/sony_display_extension     0666   root       root
/dev/sony_pq_ecs                0660   root       system
/dev/gpiochip0                  0660   root       system
/dev/gpiochip1                  0660   root       system
/dev/ttyS3                      0666   root       root
/dev/ttyUART-PROXY0             0660   root       system
/dev/ttyUSB0                    0660   root       system
/dev/rtc1                       0660   system     system

# sysfs
/sys/devices/platform/odm/odm:sony_panel*       panel_id                        0440    root    system
/sys/devices/platform/odm/odm:sony_panel*       panel_power                     0660    root    system
/sys/devices/platform/odm/odm:sony_panel*       panel_ref                       0440    root    system
/sys/devices/platform/odm/odm:sony_panel*       tcon_error                      0444    root    system
