on property:ro.boot.vendor.extended_core.sony.sw_sku="JP" && property:ro.debuggable=1
    setprop persist.vendor.sony.dbg.eventlogger.jptis /data/data/com.sony.dtv.tvinput.jptuner/cache/eventlogger/

on property:ro.boot.vendor.extended_core.sony.sw_sku="JP"
    mkdir /data/vendor/sony/jp_tis 777 system system
